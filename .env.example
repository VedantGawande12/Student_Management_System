# Environment Configuration for CIT Campus Scheduling & Venue Engine

# Optional LLM API integration for plain-language booking parser
# When not set or invalid, the system automatically uses the deterministic rule-based NLP parser
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True

