# Environment Configuration for CIT Campus Scheduling & Venue Engine

# Supabase PostgreSQL Integration
# Set these from your Supabase Project Settings -> API:
# 1. Project URL (e.g. https://xyzcompany.supabase.co)
# 2. anon or service_role key (Project API keys)
# Note: Run supabase/schema.sql once in your Supabase SQL Editor.
SUPABASE_URL=
SUPABASE_KEY=
DATABASE_URL=

# Optional LLM API integration for plain-language booking parser
# When not set or invalid, the system automatically uses the deterministic rule-based NLP parser
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True
